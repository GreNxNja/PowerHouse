# Copy to .env.local. Only NEXT_PUBLIC_* values are available in a static export,
# and they are baked into the client bundle at build time. Never put secrets here.

# Canonical origin. Used for metadata, Open Graph image URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web3Forms access key for the free-session form (create one at https://web3forms.com
# with the gym's inbox). Public by design. Without it the form explains that online
# booking is off and points to phone and WhatsApp.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Plausible (cookieless analytics + custom events). Leave empty to load nothing.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: the script URL Plausible gives you, if it isn't the default.
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
